{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Базовые права окна + запуск sidecar kadr-engine (без произвольных аргументов).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "updater:default",
    "opener:allow-open-path",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/kadr-engine",
          "sidecar": true,
          "args": []
        }
      ]
    }
  ]
}
