{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check-links",
      "type": "shell",
      "command": "docker run --rm -v \"${workspaceFolder}:/repo\" -w /repo lycheeverse/lychee --verbose --no-progress '*.md' '**/*.md'",
      "group": "test"
    },
    {
      "label": "check-spec-invariants",
      "type": "shell",
      "command": "python scripts/check-spec-invariants.py",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Check docs (links + spec)",
      "dependsOrder": "sequence",
      "dependsOn": ["check-links", "check-spec-invariants"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}